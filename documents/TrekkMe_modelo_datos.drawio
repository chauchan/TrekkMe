 style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_notificaciones_4" target="r_contactos_confianza_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="366" y="1560.0"/><mxPoint x="366" y="1060.0"/></Array></mxGeometry></mxCell><mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_validaciones_qr_1" target="r_excursiones_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1088" y="860.0"/><mxPoint x="1088" y="840.0"/></Array></mxGeometry></mxCell><mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_eventos_sos_1" target="r_excursiones_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1088" y="1040.0"/><mxPoint x="1088" y="840.0"/></Array></mxGeometry></mxCell><mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToOne;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_operativos_1" target="r_excursiones_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1088" y="1500.0"/><mxPoint x="1088" y="840.0"/></Array></mxGeometry></mxCell><mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_puntos_ubicacion_1" target="r_excursiones_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="860.0"/><mxPoint x="1490" y="783"/><mxPoint x="1088" y="783"/><mxPoint x="1088" y="840.0"/></Array></mxGeometry></mxCell><mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_validaciones_qr_2" target="r_puntos_control_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1458" y="880.0"/><mxPoint x="1458" y="380.0"/></Array></mxGeometry></mxCell><mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_operativos_2" target="r_unidades_5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1103" y="1520.0"/><mxPoint x="1103" y="430.0"/></Array></mxGeometry></mxCell><mxCell id="e26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERoneToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_operativo_rescatistas_0" target="r_operativos_0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_operativo_rescatistas_1" target="r_usuarios_12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1830" y="1500.0"/><mxPoint x="1830" y="695"/><mxPoint x="748" y="695"/><mxPoint x="748" y="390.0"/></Array></mxGeometry></mxCell><mxCell id="e28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_bitacora_entradas_1" target="r_operativos_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="1750.0"/><mxPoint x="1125" y="1480.0"/></Array></mxGeometry></mxCell><mxCell id="n_estados" value="&lt;b&gt;Máquina de estados — excursiones.estado&lt;/b&gt;&lt;br&gt;programada → en_curso&amp;nbsp;&amp;nbsp;(salida confirmada o QR de salida)&lt;br&gt;en_curso → finalizada&amp;nbsp;&amp;nbsp;(aviso de llegada o QR de llegada)&lt;br&gt;en_curso → vencida&amp;nbsp;&amp;nbsp;(motor: now &amp;gt; retorno_comprometido_at)&lt;br&gt;vencida → en_curso&amp;nbsp;&amp;nbsp;(prórroga aceptada)&lt;br&gt;vencida → en_alerta&amp;nbsp;&amp;nbsp;(escalamiento llega a la unidad)&lt;br&gt;en_alerta → finalizada&amp;nbsp;&amp;nbsp;(carabinero contacta y cierra)&lt;br&gt;en_alerta → en_operativo&amp;nbsp;&amp;nbsp;(carabinero escala, RF12)&lt;br&gt;en_operativo → finalizada&amp;nbsp;&amp;nbsp;(operativo cerrado)&lt;br&gt;programada → cancelada&lt;br&gt;SOS (RF9): pasa directo a en_alerta.&lt;br&gt;Cada transición se guarda en historial_estados." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="720" y="1440" width="360" height="229" as="geometry"/></mxCell><mxCell id="n_indices" value="&lt;b&gt;Índices y restricciones clave&lt;/b&gt;&lt;br&gt;excursiones (estado, retorno_comprometido_at) → motor RF14&lt;br&gt;excursiones (unidad_id, estado) → bandeja RF11&lt;br&gt;puntos_ubicacion (excursion_id, registrado_at)&lt;br&gt;bitacora_entradas (operativo_id, registrado_at ↓)&lt;br&gt;notificaciones (estado, programada_at) → cola&lt;br&gt;UNIQUE: usuarios.rut, usuarios.email, excursiones.codigo_qr,&lt;br&gt;&amp;nbsp;&amp;nbsp;puntos_ubicacion.uuid_cliente, contactos.token_lectura,&lt;br&gt;&amp;nbsp;&amp;nbsp;operativos.excursion_id" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="720" y="1720" width="360" height="178" as="geometry"/></mxCell><mxCell id="n_cambios" value="&lt;b&gt;Cambios respecto al modelo Firestore actual&lt;/b&gt;&lt;br&gt;• Firestore → tablas relacionales en Laravel (MySQL/PostgreSQL),&lt;br&gt;&amp;nbsp;&amp;nbsp;como define el acta. Ionic consume la API, no la BD directo.&lt;br&gt;• usuarios: se completa con rut, email, rol, estado, unidad.&lt;br&gt;• acompanantes[] (embebido) → tabla excursion_participantes.&lt;br&gt;• excursion.contactoNombre/Telefono → contactos_confianza&lt;br&gt;&amp;nbsp;&amp;nbsp;(con token de solo lectura para RF16).&lt;br&gt;• excursion.rescatistaId → operativos + operativo_rescatistas&lt;br&gt;&amp;nbsp;&amp;nbsp;(un operativo puede tener varios rescatistas).&lt;br&gt;• excursion.condicionesMedicas → perfiles_medicos (aislado).&lt;br&gt;• bitacora.excursionId → bitacora_entradas.operativo_id.&lt;br&gt;• ruta (texto) → area_id + sendero_id + ruta_declarada.&lt;br&gt;• salidaAt/retornoAt → salida_programada_at, salida_real_at,&lt;br&gt;&amp;nbsp;&amp;nbsp;retorno_comprometido_at, llegada_at.&lt;br&gt;• ultimaLat/Lng/bateria se mantienen como caché; el rastro&lt;br&gt;&amp;nbsp;&amp;nbsp;completo vive en puntos_ubicacion.&lt;br&gt;• Nuevas: prorrogas, eventos_sos, validaciones_qr,&lt;br&gt;&amp;nbsp;&amp;nbsp;historial_estados, reglas_escalamiento, notificaciones,&lt;br&gt;&amp;nbsp;&amp;nbsp;acciones_alerta, auditoria_accesos, consentimientos." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1900" y="110" width="400" height="348" as="geometry"/></mxCell><mxCell id="n_leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;PK&amp;nbsp;&amp;nbsp;clave primaria&amp;nbsp;&amp;nbsp; FK&amp;nbsp;&amp;nbsp;clave foránea&amp;nbsp;&amp;nbsp; UQ&amp;nbsp;&amp;nbsp;valor único&lt;br&gt;Texto rojo: dato sensible (salud). Acceso restringido&lt;br&gt;&amp;nbsp;&amp;nbsp;por perfil y registrado en auditoria_accesos (RNF5).&lt;br&gt;Pata de gallo: lado «muchos». Dos barras: exactamente uno.&lt;br&gt;Círculo + barra: cero o uno (FK opcional / nullable).&lt;br&gt;No se dibujan, para no saturar, las FK de autoría hacia&lt;br&gt;&amp;nbsp;&amp;nbsp;usuarios (validado_por, carabinero_id, atendido_por,&lt;br&gt;&amp;nbsp;&amp;nbsp;activado_por, autor_id, usuario_id de participantes,&lt;br&gt;&amp;nbsp;&amp;nbsp;contactos, historial, notificaciones, acciones y&lt;br&gt;&amp;nbsp;&amp;nbsp;auditoría) ni reglas.jurisdiccion_id y auditoria.excursion_id.&lt;br&gt;Omitidas: tablas propias de Laravel (personal_access_tokens&lt;br&gt;&amp;nbsp;&amp;nbsp;de Sanctum, jobs, failed_jobs, password_reset_tokens).&lt;br&gt;Tiempos «dispositivo» vs «servidor»: permiten sincronizar&lt;br&gt;&amp;nbsp;&amp;nbsp;datos tomados sin conexión sin perder el orden real (RNF1)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1900" y="560" width="400" height="280" as="geometry"/></mxCell><mxCell id="titulo" value="TrekkMe — Modelo de datos completo (Laravel · MySQL/PostgreSQL + datos geográficos)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>