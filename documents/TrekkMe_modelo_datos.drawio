;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_excursiones_4" target="t_senderos"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1133" y="920.0"/><mxPoint x="1133" y="665"/><mxPoint x="1600" y="665"/></Array></mxGeometry></mxCell><mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_excursion_participantes_1" target="r_excursiones_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="860.0"/><mxPoint x="675" y="840.0"/></Array></mxGeometry></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERoneToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_contactos_confianza_1" target="r_excursiones_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="1080.0"/><mxPoint x="675" y="840.0"/></Array></mxGeometry></mxCell><mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#555555;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="r_prorrogas_1" target="r_excursiones_0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="355" y="860.0"/><mxPoint x="355" y="783"/><mxPoint x="675" y="783"/><mxPoint x="675" y="840.0"/></Array></mxGeometry></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;startArrow=ERzeroToMany;endArro