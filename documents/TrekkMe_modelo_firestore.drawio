fontColor=#222222;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.0000;exitY=0.2267;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.9696;entryDx=0;entryDy=0;" edge="1" parent="1" source="t19" target="t8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="1758.0"/><mxPoint x="1470" y="1165"/></Array></mxGeometry></mxCell><mxCell id="e19" value="FK operativoId · 1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;startArrow=none;endArrow=open;endFill=0;endSize=8;strokeColor=#1e2a44;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t19" target="t17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e20" value="1:N embebido" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;startArrow=none;endArrow=diamondThin;endFill=0;endSize=14;strokeColor=#1e2a44;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1.0000;exitY=0.1582;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2841;entryDx=0;entryDy=0;" edge="1" parent="1" source="t17" target="t18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="FK rescatistaId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;startArrow=none;endArrow=open;endFill=0;endSize=8;strokeColor=#1e2a44;fontSize=11;fontColor=#222222;labelBackgroundColor=#ffffff;fontFamily=Helvetica;exitX=1.0000;exitY=0.2841;exitDx=0;exitDy=0;entryX=0.6765;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="t18" target="t0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2415" y="1350.0"/><mxPoint x="2415" y="480"/><mxPoint x="750" y="480"/></Array></mxGeometry></mxCell><mxCell id="n_idx" value="&lt;b&gt;Índices compuestos (obligatorios en Firestore):&lt;/b&gt;&lt;br&gt;bitacora: (excursionId ↑, registradoAt ↓)&lt;br&gt;ubicaciones: (excursionId ↑, registradoAt ↑)&lt;br&gt;excursiones: (estado ↑, retornoAt ↑) — motor de vencimiento&lt;br&gt;excursiones: (unidadId ↑, estado ↑, retornoAt ↑) — bandeja&lt;br&gt;excursiones: (contactosUids array-contains, salidaAt ↓)&lt;br&gt;excursiones: (excursionistaId ↑, salidaAt ↓)&lt;br&gt;operativos: (rescatistasUids array-contains, estado ↑)&lt;br&gt;notificaciones: (destinatarioId ↑, estado ↑, programadaAt ↓)&lt;br&gt;Firestore exige un índice compuesto cuando se filtra por un&lt;br&gt;campo y se ordena por otro distinto." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#1e2a44;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2480" y="520" width="420" height="226" as="geometry"/></mxCell><mxCell id="n_est" value="&lt;b&gt;estado de excursiones — 7 valores:&lt;/b&gt;&lt;br&gt;programada → en_curso → finalizada&lt;br&gt;en_curso → vencida (motor: ahora &amp;gt; retornoAt)&lt;br&gt;vencida → en_curso (prórroga) | en_alerta (escala a la unidad)&lt;br&gt;en_alerta → finalizada (carabinero cierra) | en_operativo&lt;br&gt;en_operativo → finalizada · programada → cancelada&lt;br&gt;SOS pasa directo a en_alerta. Cada cambio queda en&lt;br&gt;historialEstados. El motor corre en una Cloud Function&lt;br&gt;programada, no en la app (RNF2)." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#1e2a44;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2480" y="760" width="420" height="190" as="geometry"/></mxCell><mxCell id="n_ley" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;— línea punteada con flecha: relación por convención (FK), no&lt;br&gt;&amp;nbsp;&amp;nbsp;forzada por Firestore&lt;br&gt;— flecha en rombo: estructura embebida dentro del mismo&lt;br&gt;&amp;nbsp;&amp;nbsp;documento&lt;br&gt;— contorno punteado: estructura embebida, no es una colección&lt;br&gt;— (copia): dato duplicado para no hacer joins (NoSQL)&lt;br&gt;— FK hacia usuarios no dibujadas para no saturar: validadoPor,&lt;br&gt;&amp;nbsp;&amp;nbsp;usuarioId, carabineroId, atendidoPor, activadoPor,&lt;br&gt;&amp;nbsp;&amp;nbsp;destinatarioId, updatedBy; tampoco excursiones.operativoId,&lt;br&gt;&amp;nbsp;&amp;nbsp;operativos.unidadRescateId ni auditoria (ver campos en cursiva)&lt;br&gt;— dato sensible: acceso restringido por perfil y registrado&lt;br&gt;&amp;nbsp;&amp;nbsp;en auditoria (RNF5, Ley 21.719)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fillColor=#ffffff;strokeColor=#1e2a44;dashed=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2480" y="970" width="420" height="262" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>